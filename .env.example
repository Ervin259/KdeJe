# Skopírujte do .env.local (lokálne) a rovnaké hodnoty zadajte vo Verceli
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# E-maily z aplikácie (upozornenia superadmina) – rovnaké SMTP údaje ako v Supabase (Brevo → Settings → SMTP & API → SMTP)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# MAIL_FROM=noreply@kdeje.app
